ACTION=="add", SUBSYSTEM=="cpu", RUN+="/bin/chmod 0666 /sys/devices/system/cpu/intel_pstate/no_turbo /sys/devices/system/cpu/intel_pstate/max_perf_pct"
ACTION=="add", SUBSYSTEM=="drm", KERNEL=="card0", RUN+="/bin/chmod 0666 /sys/class/drm/card0/gt_max_freq_mhz /sys/class/drm/card0/gt_boost_freq_mhz"